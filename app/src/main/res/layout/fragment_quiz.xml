<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_background"
    android:orientation="vertical">

    <!-- CABEÇALHO TÁTICO S.H.I.E.L.D. EM UMA LINHA SIMPLES -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <!-- Botão de Voltar (seta) visível apenas durante as perguntas -->
        <ImageView
            android:id="@+id/btnQuizBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_quiz_arrow_back"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar ao início"
            android:visibility="gone"
            app:tint="@color/quiz_text_primary" />

        <!-- Logo S.H.I.E.L.D. visível na seleção de nível e resultados -->
        <ImageView
            android:id="@+id/ivShieldLogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_shield_logo"
            android:layout_marginEnd="10dp"
            android:contentDescription="S.H.I.E.L.D."
            app:tint="@color/quiz_text_secondary" />

        <!-- Título Simples em uma linha -->
        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QUIZ"
            android:textColor="@color/quiz_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06" />

        <!-- Botão do Troféu -->
        <FrameLayout
            android:id="@+id/btnTrophy"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_quiz_letter_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_quiz_trophy"
                app:tint="#F9A825"
                android:contentDescription="Troféus" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. TELA DE SELEÇÃO DE DIFICULDADE -->
        <ScrollView
            android:id="@+id/levelSelectContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="68dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECIONE SEU NÍVEL DE APTIDÃO"
                    android:textColor="@color/quiz_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp" />

                <!-- Card FÁCIL: RECRUTA (Verde #2E7D32) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLevelFacil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/quiz_card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/quiz_level_facil"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    app:rippleColor="#152E7D32">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_quiz_chip_facil">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="LVL 1"
                                android:textColor="@color/quiz_level_facil"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-condensed" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECRUTA"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fundamentos dos heróis fundadores dos Vingadores"
                                android:textColor="@color/quiz_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/quiz_level_facil"
                            android:contentDescription="Iniciar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card MÉDIO: ESPECIALISTA (Amarelo #F9A825) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLevelMedio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/quiz_card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/quiz_level_medio"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    app:rippleColor="#15F9A825">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_quiz_chip_medio">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="LVL 5"
                                android:textColor="@color/quiz_level_medio"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-condensed" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ESPECIALISTA"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mistérios do MCU, Joias do Infinito e eventos cósmicos"
                                android:textColor="@color/quiz_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/quiz_level_medio"
                            android:contentDescription="Iniciar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card DIFÍCIL: DIRETOR (Vermelho #C62828) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLevelDificil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/quiz_card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/quiz_level_dificil"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    app:rippleColor="#15C62828">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_quiz_chip_dificil">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="LVL 10"
                                android:textColor="@color/quiz_level_dificil"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-condensed" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DIRETOR"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Conhecimento secreto de quadrinhos, criadores e lore bruto"
                                android:textColor="@color/quiz_text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/quiz_level_dificil"
                            android:contentDescription="Iniciar" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- 2. TELA DE PERGUNTAS ATIVAS -->
        <ScrollView
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp">

                <!-- Status Bar: Progresso + Nível -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvQuestionProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FASE 1 / 5"
                        android:textColor="@color/quiz_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvCurrentLevelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECRUTA"
                        android:textColor="@color/quiz_level_facil"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_quiz_lvl_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- Barra de Progresso Fina na Cor do Nível -->
                <ProgressBar
                    android:id="@+id/quizProgressBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="5"
                    android:progress="1"
                    android:progressTint="@color/quiz_level_facil"
                    android:progressBackgroundTint="@color/quiz_border"
                    android:layout_marginBottom="16dp" />

                <!-- Card de Pergunta: Fundo #1C1C1C, Cantos 16dp, Texto 20sp bold -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/quiz_card_bg"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/quiz_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DESAFIO TÁTICO"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvQuestionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Qual é o nome civil do Homem de Ferro?"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4 Alternativas com altura mínima 56dp, cantos 12dp, círculo #2A2A2A e espaçamento 12dp -->
                <LinearLayout
                    android:id="@+id/optionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- OPÇÃO A -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOpt0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/quiz_card_bg"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/quiz_border"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#15FFFFFF"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <FrameLayout
                                android:id="@+id/badgeLetter0"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_quiz_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="A"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvOptText0"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Opção A"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:id="@+id/ivStatusOpt0"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:visibility="gone"
                                android:contentDescription="Status da resposta" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- OPÇÃO B -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOpt1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/quiz_card_bg"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/quiz_border"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#15FFFFFF"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <FrameLayout
                                android:id="@+id/badgeLetter1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_quiz_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="B"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvOptText1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Opção B"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:id="@+id/ivStatusOpt1"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:visibility="gone"
                                android:contentDescription="Status da resposta" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- OPÇÃO C -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOpt2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/quiz_card_bg"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/quiz_border"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#15FFFFFF"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <FrameLayout
                                android:id="@+id/badgeLetter2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_quiz_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="C"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvOptText2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Opção C"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:id="@+id/ivStatusOpt2"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:visibility="gone"
                                android:contentDescription="Status da resposta" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- OPÇÃO D -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOpt3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/quiz_card_bg"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/quiz_border"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#15FFFFFF"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <FrameLayout
                                android:id="@+id/badgeLetter3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_quiz_letter_circle">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="D"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:fontFamily="sans-serif-medium" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvOptText3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Opção D"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginStart="14dp"
                                android:layout_marginEnd="8dp" />

                            <ImageView
                                android:id="@+id/ivStatusOpt3"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:visibility="gone"
                                android:contentDescription="Status da resposta" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Feedback / Dossiê Explicativo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/quiz_card_bg_subtle"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/quiz_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:visibility="gone"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOSSIÊ TÁTICO REVELADO"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvExplanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botão Próxima Questão -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="PRÓXIMA QUESTÃO"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/quiz_level_facil"
                    android:layout_marginBottom="12dp" />

                <!-- Rodapé Tático de Status / Distribuição Vertical -->
                <LinearLayout
                    android:id="@+id/layoutTacticalFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvLiveScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACERTOS: 0"
                        android:textColor="@color/quiz_text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTOCOLO DE AVALIAÇÃO"
                        android:textColor="@color/quiz_text_muted"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.06" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 3. TELA DE RESULTADOS COM VISUAL S.H.I.E.L.D. CONFIDENTIAL -->
        <ScrollView
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="68dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/quiz_card_bg"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="@color/quiz_border"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="26dp"
                        android:gravity="center_horizontal">

                        <!-- Badge Icon -->
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_quiz_letter_circle"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_quiz_trophy"
                                app:tint="#F9A825"
                                android:contentDescription="Troféu de conclusão" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIMULAÇÃO TÁTICA FINALIZADA"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/tvFinalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 / 5"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvAccuracyPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% DE PRECISÃO OPERACIONAL"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08"
                            android:layout_marginTop="4dp" />

                        <View
                            android:layout_width="48dp"
                            android:layout_height="1dp"
                            android:background="@color/quiz_border"
                            android:layout_marginVertical="18dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PATENTE S.H.I.E.L.D. CONQUISTADA:"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvRankTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIRETOR SUPREMO // NÍVEL 10"
                            android:textColor="#F9A825"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:layout_marginTop="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRestartQuiz"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="24dp"
                            android:text="JOGAR NOVAMENTE"
                            android:textColor="@color/quiz_text_primary"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            app:cornerRadius="12dp"
                            app:backgroundTint="#262626"
                            app:strokeColor="@color/quiz_border"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
