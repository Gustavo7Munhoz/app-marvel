<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/joias_background"
    android:clipToPadding="false"
    android:paddingBottom="68dp">

    <!-- CABEÇALHO SÓBRIO / TÍTULO EM UMA LINHA COM ÍCONE S.H.I.E.L.D. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_shield_logo"
            android:layout_marginEnd="10dp"
            app:tint="@color/joias_text_secondary"
            android:contentDescription="S.H.I.E.L.D." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOIAS DO INFINITO"
            android:textColor="@color/joias_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- INSTRUÇÃO PEQUENA E DISCRETA EM #9A9A9A -->
    <TextView
        android:id="@+id/tvHintCarousel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deslize o carrossel orbital · Toque na joia para inspecionar em 3D"
        android:textColor="@color/joias_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CARROSSEL ORBITAL DE JOIAS (DIMENSIONADO PARA NÃO CORTAR E NÃO PASSAR SOB O HEADER) -->
    <com.example.marvel.ui.joias.GemWheelView
        android:id="@+id/gemWheelView"
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvHintCarousel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CARD DA JOIA (FUNDO #1C1C1C, CANTOS 16DP, BORDA FINA NA COR DA JOIA) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/joias_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="#7B00E0"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/gemWheelView"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Título em Destaque Centralizado (na cor da Joia) -->
                <TextView
                    android:id="@+id/tvGemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="JOIA DO PODER"
                    android:textColor="#7B00E0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:gravity="center" />

                <!-- Traço Fino Decorativo (na cor da Joia) -->
                <View
                    android:id="@+id/dividerGem"
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#7B00E0"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="8dp" />

                <!-- Linha AFETA em #EAEAEA, tamanho 14sp legível (sem usar cor da joia) -->
                <TextView
                    android:id="@+id/tvGemAffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AFETA: FORÇA, ENERGIA E DESTRUIÇÃO CÓSMICA"
                    android:textColor="@color/joias_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:gravity="center" />

                <!-- Descrição em #CFCFCF, 15sp, alinhada à esquerda com espaçamento confortável -->
                <TextView
                    android:id="@+id/tvGemPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amplifica qualquer força ao nível cósmico. Com ela é possível destruir planetas inteiros com um toque. Potencializa o efeito de todas as outras joias simultaneamente."
                    android:textColor="@color/joias_text_description"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp" />

                <!-- CAIXA DE ESPECIFICAÇÕES TÉCNICAS (RÓTULO #9A9A9A + VALOR #EAEAEA) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_joias_data_box"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="16dp">

                    <!-- Linha 1: Métrica Primária -->
                    <TextView
                        android:id="@+id/tvLabelRadGamma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMISSÃO DE ENERGIA"
                        android:textColor="@color/joias_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvRadGamma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9,87 TeraElectronVolts // Energia Pura"
                        android:textColor="@color/joias_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />

                    <!-- Divisor Interno Fino -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/joias_divider_inner"
                        android:layout_marginVertical="8dp" />

                    <!-- Linha 2: Classificação de Ameaça -->
                    <TextView
                        android:id="@+id/tvLabelAmeaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLASSIFICAÇÃO DE AMEAÇA"
                        android:textColor="@color/joias_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvNivelAmeaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classe Ômega // Nível Cósmico"
                        android:textColor="@color/joias_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- PORTADORES CONHECIDOS (RÓTULO #9A9A9A E LISTA EM #EAEAEA) -->
                <TextView
                    android:id="@+id/tvLabelUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORTADORES CONHECIDOS"
                    android:textColor="@color/joias_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvGemUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ronan, Senhor das Estrelas, Thanos"
                    android:textColor="@color/joias_text_primary"
                    android:textSize="13.5sp"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── EXPAND OVERLAY (Inspeção Holográfica 3D) ── -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA020306"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título em Destaque 3D -->
    <TextView
        android:id="@+id/tvExpandedGemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/shield_cyan_glow"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.08"
        android:visibility="gone"
        android:elevation="25dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/expandedGemView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gem 3D expandida -->
    <com.example.marvel.ui.joias.GemExpandedView
        android:id="@+id/expandedGemView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:visibility="gone"
        android:elevation="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.46" />

    <TextView
        android:id="@+id/tvCloseHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque no fundo escuro para fechar · Arraste para girar em 360°"
        android:textColor="@color/joias_text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="44dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
