<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="2dp">

    <!-- ABINHA SUPERIOR DA PASTA FÍSICA MANILA/KRAFT -->
    <LinearLayout
        android:id="@+id/tabFolder"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_folder_tab"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/tvIdPasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHIELD // FILE"
            android:textColor="@color/dossier_text_sub"
            android:textSize="8sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- CORPO PRINCIPAL DA PASTA KRAFT BEGE -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp"
        app:cardBackgroundColor="@color/dossier_folder_manila"
        app:cardCornerRadius="8dp"
        app:strokeColor="@color/dossier_folder_border"
        app:strokeWidth="1.2dp"
        app:cardElevation="3dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- RETRATO DO PERSONAGEM (MOLDURA FOTOGRÁFICA) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#201A14"
                    android:contentDescription="Retrato do Operativo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.DossierPhoto"
                    app:strokeColor="@color/dossier_folder_border"
                    app:strokeWidth="1dp" />
            </FrameLayout>

            <!-- IDENTIFICAÇÃO DO PERSONAGEM EM TIPOGRAFIA MÁQUINA DE ESCREVER (MONOSPACE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <!-- Nome do Personagem em Monospace -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOME DO OPERATIVO"
                    android:textColor="@color/dossier_text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Subtítulo / Identidade Secreta / Dossiê -->
                <TextView
                    android:id="@+id/tvAlias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Identidade Secreta"
                    android:textColor="@color/dossier_text_sub"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
