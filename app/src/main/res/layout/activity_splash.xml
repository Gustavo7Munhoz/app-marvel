<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_black"
    android:clickable="true"
    android:focusable="true">

    <!-- FUNDO: Customizado Doom/Noir (Inalterado) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/splash_bg_final"
        android:scaleType="centerCrop"
        android:alpha="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- OVERLAY GRADIENTE (Inalterado) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CONTAINER DO LOGO S.H.I.E.L.D. COM CLIP PARA O SCANNER -->
    <FrameLayout
        android:id="@+id/logoContainer"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:clipChildren="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSplashTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_shield_logo"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:contentDescription="S.H.I.E.L.D." />

        <!-- Linha de scanner horizontal dourada #F9A825 -->
        <View
            android:id="@+id/viewScannerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/bg_scanner_line"
            android:visibility="gone" />
    </FrameLayout>

    <!-- TÍTULO S.H.I.E.L.D. -->
    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S.H.I.E.L.D."
        android:textColor="@color/shield_white"
        android:textSize="42sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:fontFamily="sans-serif-condensed"
        android:alpha="0"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TEXTO TÁTICO DE VERIFICAÇÃO / ACESSO CONCEDIDO (Passo C) -->
    <TextView
        android:id="@+id/tvAccessStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F9A825"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:alpha="0"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTÃO "TOQUE PARA ENTRAR" DOURADO #F9A825 COM PULSO -->
    <TextView
        android:id="@+id/tvEnterButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOQUE PARA ENTRAR"
        android:textColor="#F9A825"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:alpha="0"
        android:contentDescription="Toque para entrar no sistema S.H.I.E.L.D."
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
