<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dossier_background"
    android:orientation="vertical">

    <!-- CABEÇALHO SÓBRIO / TÍTULO SIMPLES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_shield_logo"
            android:layout_marginEnd="10dp"
            app:tint="@color/shield_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOSSIÊ DE OPERATIVOS"
            android:textColor="@color/shield_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- CAMPO DE BUSCA CLEAN COM BOTÃO DE FILTRO INTEGRADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <!-- Barra de Busca -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_dossier"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search_modern"
                android:layout_marginEnd="10dp"
                app:tint="@color/shield_text_secondary" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Pesquisar herói ou vilão..."
                android:textColorHint="@color/shield_text_secondary"
                android:textColor="@color/shield_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:background="@android:color/transparent"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Botão de Filtro Integrado -->
        <FrameLayout
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_filter_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/shield_text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- PROGRESS BAR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="56dp"
        android:indeterminateTint="@color/nav_accent_gold"
        android:visibility="gone" />

    <!-- MENSAGEM DE VAZIO OU ERRO -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:textColor="@color/shield_text_secondary"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- RECYCLERVIEW GRADE DE PASTAS MANILA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCharacters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="10dp"
        android:paddingBottom="84dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
