<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <!-- PAINEL DE METAL TÁTICO (MONITOR MILITAR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_painel_metal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <!-- Marcador Data Tática em Caixa Metálica -->
        <LinearLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_data_metal">

            <TextView
                android:id="@+id/tvMes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAI"
                android:textColor="@color/shield_orange_neon"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026"
                android:textColor="@color/shield_text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Detalhes da Missão Cinematográfica no Monitor Tático -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloFilme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VINGADORES: DOOMSDAY"
                android:textColor="@color/shield_text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.03"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvFaseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FASE 6 // CINEMAS GLOBAIS"
                android:textColor="@color/shield_cyan_pure"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvSinopseFilme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O retorno histórico dos irmãos Russo na direção e Robert Downey Jr. como Victor von Doom."
                android:textColor="@color/shield_text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
