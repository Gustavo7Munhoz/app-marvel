<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo de Base com Borda Metálica Chanfrada -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#364252" />
        </shape>
    </item>

    <!-- Miolo Escuro com Textura Militar -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#1A2027"
                android:centerColor="#14181E"
                android:endColor="#111418"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#252D37" />
        </shape>
    </item>

    <!-- Borda Superior Metálica de Destaque (Friso de Aço) -->
    <item
        android:left="24dp"
        android:right="24dp"
        android:top="0dp"
        android:height="2.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#0038445A"
                android:centerColor="#804FC3F7"
                android:endColor="#0038445A" />
        </shape>
    </item>
</layer-list>
