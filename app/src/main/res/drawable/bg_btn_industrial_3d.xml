<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow externo / Borda neon brilhante -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/shield_cyan_neon" />
        </shape>
    </item>
    <!-- Interior escuro industrial com gradiente de chumbo metálico -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E2738"
                android:centerColor="#101622"
                android:endColor="#151E2C"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4000E5FF" />
        </shape>
    </item>
</layer-list>
