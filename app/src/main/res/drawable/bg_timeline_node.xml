<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo exterior luminoso -->
    <item>
        <shape android:shape="oval">
            <size android:width="16dp" android:height="16dp" />
            <solid android:color="#3300F0FF" />
        </shape>
    </item>
    <!-- Anel metálico de proteção -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/shield_cyan_pure" />
            <solid android:color="#12161A" />
        </shape>
    </item>
    <!-- Núcleo central neon -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/shield_cyan_pure" />
        </shape>
    </item>
</layer-list>
