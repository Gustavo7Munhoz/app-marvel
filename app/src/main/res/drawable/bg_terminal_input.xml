<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#14181D" />
            <stroke android:width="1.5dp" android:color="@color/shield_cyan_pure" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A2026" />
            <stroke android:width="1dp" android:color="#334FC3F7" />
        </shape>
    </item>
</selector>
