<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Borda externa da aba -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dossier_folder_border" />
            <corners
                android:topLeftRadius="7dp"
                android:topRightRadius="7dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Preenchimento kraft da aba aberto na base para fundir com a pasta -->
    <item
        android:left="1.2dp"
        android:top="1.2dp"
        android:right="1.2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dossier_folder_manila" />
            <corners
                android:topLeftRadius="6dp"
                android:topRightRadius="6dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
