<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Borda externa com gradiente metálico simulando aço escovado e bisel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="90"
                android:startColor="#1E2638"
                android:centerColor="#4A5A78"
                android:endColor="#1E2638"
                android:type="linear" />
        </shape>
    </item>
    <!-- Miolo do painel de controle com azul noturno e textura de metal escuro -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#161E2E"
                android:centerColor="#0E131C"
                android:endColor="#131A26"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2C3A50" />
        </shape>
    </item>
</layer-list>
